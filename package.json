{
  "name": "@global-torque/design-tokens",
  "private": false,
  "version": "0.3.1",
  "description": "Source design tokens for Global Torque.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "css",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "eslint --max-warnings=0 src vitest.config.mjs",
    "format:check": "prettier --check \"src/**/*.{json,yaml,yml}\"",
    "format:write": "prettier --write \"src/**/*.{json,yaml,yml}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/design-tokens.git"
  },
  "homepage": "https://github.com/global-torque/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/global-torque/design-tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["src", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md", "SECURITY.md"]
}
