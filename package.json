{
  "name": "@global-torque/design-tokens",
  "private": false,
  "version": "0.4.0",
  "description": "Neutral design tokens generated deterministically from one DTCG source.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "css",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "sideEffects": [
    "./dist/*.css"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "lint": "eslint --max-warnings=0 scripts src vitest.config.mjs",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.json\" \".github/**/*.{yml,json,md}\" \"docs/{rfcs,ossf}/**/*.md\" \"*.{json,md,yaml}\"",
    "format:write": "prettier --write \"scripts/**/*.mjs\" \"src/**/*.json\" \".github/**/*.{yml,json,md}\" \"docs/{rfcs,ossf}/**/*.md\" \"*.{json,md,yaml}\"",
    "test:run": "pnpm run build && vitest run",
    "browser:install": "playwright install --with-deps chromium",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run test:run",
    "tokens:derive": "node scripts/derive-tokens.mjs && prettier --write src/tokens.tokens.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/design-tokens.git"
  },
  "homepage": "https://github.com/global-torque/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/global-torque/design-tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/index.css",
      "import": "./dist/css.js",
      "default": "./dist/index.css"
    },
    "./derive": {
      "types": "./dist/derive.d.ts",
      "import": "./dist/derive.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./source": "./dist/tokens.tokens.json"
  }
}
