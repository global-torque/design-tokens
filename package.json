{
  "name": "@global-torque/design-tokens",
  "private": false,
  "version": "0.4.0",
  "description": "Source design tokens for Global Torque.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "css",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "sideEffects": ["./dist/*.css"],
  "exports": {
    "./css": "./dist/index.css"
  },
  "scripts": {
    "prepack": "node scripts/build.mjs",
    "lint": "eslint --max-warnings=0 scripts",
    "format:check": "prettier --check \"src/**/*.{json,yaml,yml}\"",
    "format:write": "prettier --write \"src/**/*.{json,yaml,yml}\"",
    "ci": "pnpm run format:check && pnpm run lint && pnpm pack --pack-destination release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/design-tokens.git"
  },
  "homepage": "https://github.com/global-torque/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/global-torque/design-tokens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ]
}
