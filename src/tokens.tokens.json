        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.3098, 1]
        }
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.8627, 0.5922]
