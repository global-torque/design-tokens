{
  "$description": "Neutral institutional design tokens for administrative and content interfaces.",
  "$extensions": {
    "org.global-torque.source": {
      "format": "DTCG 2025.10",
      "specification": "https://www.designtokens.org/TR/2025.10/format/"
    }
  },
  "primitive": {
    "$description": "Raw values. Product meaning must be expressed through semantic aliases.",
    "brand": {
      "$description": "Brand seed values, emitted as --brand-* custom properties.",
      "primary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.3098, 1]
        }
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.8627, 0.5922]
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3569, 0.3333, 0.8392]
        }
      },
      "surface-light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1]
        }
      },
      "surface-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0863, 0.1216]
        }
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{primitive.brand.surface-light}"
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{primitive.brand.surface-dark}"
      },
      "tertiary-foreground": {
        "$type": "color",
        "$value": "{primitive.brand.surface-light}"
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "font-sans": {
        "$type": "fontFamily",
        "$value": [
          "Avenir",
          "Avenir Next",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      }
    },
